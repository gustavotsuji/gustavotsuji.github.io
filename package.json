{
  "name": "gustavo-tsuji-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build --webpack",
    "seo:build": "next build",
    "seo:start": "http-server ./out -p 3000",
    "seo:serve-static": "http-server ./out -p 3000",
    "seo:lhci": "lhci autorun --config=lhci.config.js",
    "seo": "yarn seo:build && (yarn seo:start & echo $! > .seo.pid) && npx wait-on http://localhost:3000 && yarn seo:lhci; kill $(cat .seo.pid) || true; rm -f .seo.pid",
    "images:optimize": "node scripts/optimize-images.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "export": "next build && next export",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "postbuild": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "date-fns": "^4.1.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "minimatch": "10.2.5",
    "next": "^16.2.4",
    "next-mdx-remote": "6.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rimraf": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/eslintrc": "3.3.5",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.2.4",
    "@tailwindcss/postcss": "4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "^10.5.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "4.2.2",
    "typescript": "^5.3.3",
    "wait-on": "^9.0.5"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "tmp": "0.2.5",
    "glob": "^13.0.0",
    "rimraf": "^6.0.0",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3",
    "flatted": "^3.4.2",
    "path-to-regexp": "0.1.13",
    "brace-expansion": "^2.0.3",
    "whatwg-encoding": "^3.1.1",
    "minimatch": "^9.0.7",
    "yauzl": "^3.2.1",
    "basic-ftp": "^5.3.0",
    "follow-redirects": "^1.16.0"
  }
}
